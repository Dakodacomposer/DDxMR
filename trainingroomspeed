extends Node2D


func _ready() -> void:
	update_speed_label()
	$WarriorUnit/AnimatedSprite2D.play("Attack")
	$WarriorUnit/AnimatedSprite2D.animation_finished.connect(_on_animation_finished)
	
	
func _on_animation_finished():
	$Timer.start()
	increment_speed(1)
	update_speed_label()


func _on_timer_timeout() -> void:
	get_tree().change_scene_to_file("res://Scenes/town_hub.tscn")


func increment_speed(amount):
	RunManager.current_speed += amount
	
func update_speed_label():
	$CanvasLayer/Control/Label.text = str("Speed: ", RunManager.current_speed)
