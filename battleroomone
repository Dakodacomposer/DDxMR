extends Control


@onready var enemy = $Enemy1DuringBattle
@onready var player = $PlayerDuringBattle

var player_turn: bool = true

var parry_and_opened_active: bool = false
var relentless_pursuit_active: bool = false


func _ready() -> void:
	update_stat_labels()
	$StatsPanel.hide()





func _on_end_turn_timer_timeout() -> void:
	enemy.attack()
	if relentless_pursuit_active:
		relentless_pursuit_active = false
		$EndTurnTimer.start()
	else:
		player_turn = true



func _on_dash_attack_pressed() -> void:
	if player_turn == true:
		RunManager.temp_strength += 1
		if parry_and_opened_active == true:
			enemy.take_damage((15 + RunManager.get_combined_strength() * 2) * 2)
			parry_and_opened_active = false
			player_turn = false
			$EndTurnTimer.start()
		else:
			enemy.take_damage(15 + (RunManager.get_combined_strength() * 2))
			player_turn = false
			$EndTurnTimer.start()
		print(enemy.current_health)
		print("run manager temp strength: ", RunManager.temp_strength)
		print(RunManager.get_combined_strength())


func _on_suplex_pressed() -> void:
	if player_turn == true:
		RunManager.temp_defense += 1
		if parry_and_opened_active == true:
			enemy.take_damage((15 + RunManager.get_combined_defense()
			 + RunManager.get_combined_strength()) * 2)
			parry_and_opened_active = false
			player_turn = false
			$EndTurnTimer.start()
		else:
			enemy.take_damage(15 + (RunManager.get_combined_defense()
		 	+ RunManager.get_combined_strength()))
			player_turn = false
			$EndTurnTimer.start()
		print(enemy.current_health)
		print("combined strength: ", RunManager.get_combined_strength())
		print("combined defense: ", RunManager.get_combined_defense())


#dont forget to wire the enemy to hit 1.5x if active
func _on_parry_and_open_pressed() -> void:
	if player_turn == true:
		parry_and_opened_active = true
		RunManager.temp_speed += 1
		RunManager.temp_strength += 1
		player_turn = false
		$EndTurnTimer.start()
		

#wire in lose next turn
func _on_relentless_pursuit_pressed() -> void:
	if player_turn == true:
		if parry_and_opened_active == true:
			enemy.take_damage((25 + RunManager.get_combined_defense() + 
			RunManager.get_combined_speed() + RunManager.get_combined_strength())
			* 2)
			parry_and_opened_active = false
			player_turn = false
			relentless_pursuit_active = true
			$EndTurnTimer.start()
		else:
			enemy.take_damage(25 + (RunManager.get_combined_defense() + 
			RunManager.get_combined_speed() + RunManager.get_combined_strength())
			)
			player_turn = false
			relentless_pursuit_active = true
			$EndTurnTimer.start()
		print(enemy.current_health)


func update_stat_labels():
	$StatsPanel/Strength.text = str("Strength: ", RunManager.current_strength, " + ", "(", RunManager.temp_strength, ")")
	$StatsPanel/Defense.text = str("Defense: ", RunManager.current_defense, " + ", "(", RunManager.temp_defense, ")")
	$StatsPanel/Speed.text = str("Speed: ", RunManager.current_speed, " + ", "(", RunManager.temp_speed, ")")



func _on_check_stats_pressed() -> void:
	$StatsPanel.show()


func _on_close_pressed() -> void:
	$StatsPanel.hide()
