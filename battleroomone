extends Control


@onready var enemy = $Enemy1DuringBattle
@onready var player = $PlayerDuringBattle

var player_turn: bool = true

var parry_and_opened_active: bool = false
var relentless_pursuit_active: bool = false
var first_attack: bool = false


func _ready() -> void:
	update_stat_labels()
	$StatsPanel.hide()
	$PassivesPanel.hide()
	update_passive_panel()
	if RunManager.libra:
		RunManager.temp_defense += 2
		RunManager.temp_speed += 2
		RunManager.temp_strength += 2
		print("libra temp stats gained")





func _on_end_turn_timer_timeout() -> void:
	enemy.attack()
	if relentless_pursuit_active:
		relentless_pursuit_active = false
		$EndTurnTimer.start()
	else:
		player_turn = true



func _on_dash_attack_pressed() -> void:
	if player_turn == true:
		if RunManager.pro_wrestler == false:
			RunManager.temp_defense -= 1
		RunManager.temp_speed += 1
			#establish base damage first
			#use helper funcs to check if passives increase dmg below
		var damage = 15 + RunManager.get_combined_strength() * 2
		damage += RunManager.get_passive_bonus_damage()
			
		if first_attack == true and RunManager.desperate:
			damage += 15
			first_attack = false
			
			
			#check if parry and open active
		if parry_and_opened_active == true:
			damage *= 2
			parry_and_opened_active = false
			
			#take final dmg and cleanup
		enemy.take_damage(damage)
		player_turn = false
		apply_stalwart()
		$EndTurnTimer.start()
		print(enemy.current_health)


func _on_suplex_pressed() -> void:
	if player_turn == true:
		if RunManager.pro_wrestler == true:
			RunManager.temp_strength += 1
		RunManager.temp_defense += 1
		var damage: int = 15 + (RunManager.get_combined_defense() + 
		RunManager.get_combined_strength()) + RunManager.get_passive_bonus_damage()
		
		if first_attack == true and RunManager.desperate:
			damage += 15
			first_attack = false
		
		if parry_and_opened_active == true:
			damage *= 2
			parry_and_opened_active = false
			
		enemy.take_damage(damage)
		player_turn = false
		apply_stalwart()
		$EndTurnTimer.start()
		
		print(enemy.current_health)
		print("combined strength: ", RunManager.get_combined_strength())
		print("combined defense: ", RunManager.get_combined_defense())


#dont forget to wire the enemy to hit 1.5x if active
func _on_parry_and_open_pressed() -> void:
	if player_turn == true:
		parry_and_opened_active = true
		RunManager.temp_speed += 1
		RunManager.temp_strength += 1
		apply_stalwart()
		player_turn = false
		$EndTurnTimer.start()
		

func _on_relentless_pursuit_pressed() -> void:
	if player_turn == true:
		var damage: int = 25 + (RunManager.get_combined_defense() + 
		RunManager. get_combined_speed() + RunManager.get_combined_strength()) + RunManager.get_passive_bonus_damage()
		
		if first_attack == true and RunManager.desperate:
			damage += 15
			first_attack = false
		
		
		if parry_and_opened_active == true:
			damage *= 2
			parry_and_opened_active = false
			
		if RunManager.final_act:
			damage *= 3
			
		enemy.take_damage(damage)
		player_turn = false
		apply_stalwart()
		relentless_pursuit_active = true
		$EndTurnTimer.start()
		
		print(enemy.current_health)


func apply_stalwart() -> void:
	if RunManager.stalwart:
		player.gain_shield(10)


func update_stat_labels():
	$StatsPanel/Strength.text = str("Strength: ", RunManager.current_strength, " + ", "(", RunManager.temp_strength, ")")
	$StatsPanel/Defense.text = str("Defense: ", RunManager.current_defense, " + ", "(", RunManager.temp_defense, ")")
	$StatsPanel/Speed.text = str("Speed: ", RunManager.current_speed, " + ", "(", RunManager.temp_speed, ")")



func _on_check_stats_pressed() -> void:
	$StatsPanel.show()


func _on_close_pressed() -> void:
	$StatsPanel.hide()


func _on_check_passives_pressed() -> void:
	$PassivesPanel.show()


func _on_close_passives_button_pressed() -> void:
	$PassivesPanel.hide()
	
func update_passive_panel() -> void:
	$PassivesPanel/VBoxContainerLeft/GymRat.visible = RunManager.gym_rat
	$PassivesPanel/VBoxContainerLeft/Desperate.visible = RunManager.desperate
	$PassivesPanel/VBoxContainerLeft/Stalwart.visible = RunManager.stalwart
	$PassivesPanel/VBoxContainer/Libra.visible = RunManager.libra
	$PassivesPanel/VBoxContainer/ProWrestler.visible = RunManager.pro_wrestler
	$PassivesPanel/VBoxContainer/FinalAct.visible = RunManager.final_act
